# Copy this file to .env and replace the placeholders with real values.
# Keep the value quoted: the #fragment gives each subscription its dashboard name.
SUBSCRIPTION_URL="https://example.com/220v-subscription#220V,https://example.com/wssub-subscription#LETO,https://example.com/heltoma-subscription#MASTER"

# Device identifier sent to subscription services in the X-Hwid header.
# Treat it as a secret and never commit the real value.
HWID="replace-with-your-hwid"

# Bind each subscription name (the #fragment above) to its Remnawave API.
# A panel may be listed with an empty URL and token until its API is connected;
# URL and token must otherwise be filled together.
REMNAWAVE_PANELS="rw220,rwleto,rwmaster,rwdog"

REMNAWAVE_RW220_SUBSCRIPTION="220V"
REMNAWAVE_RW220_API_URL=""
REMNAWAVE_RW220_API_TOKEN=""

REMNAWAVE_RWLETO_SUBSCRIPTION="LETO"
REMNAWAVE_RWLETO_API_URL=""
REMNAWAVE_RWLETO_API_TOKEN=""

REMNAWAVE_RWMASTER_SUBSCRIPTION="MASTER"
REMNAWAVE_RWMASTER_API_URL=""
REMNAWAVE_RWMASTER_API_TOKEN=""

REMNAWAVE_RWDOG_SUBSCRIPTION="DOG"
REMNAWAVE_RWDOG_API_URL=""
REMNAWAVE_RWDOG_API_TOKEN=""

# Compose defaults this to LTE. Override it with a comma-separated list of
# case-insensitive host-name prefixes or standalone markers to omit from Xray
# generation, monitoring, metrics, alerts, APIs, and the dashboard.
# PROXY_EXCLUDE_NAME_PREFIXES="LTE,TEST"

# Optional: manage Telegram outside the dashboard. When set, the token is
# read-only in the UI and these environment values take precedence.
# TELEGRAM_BOT_TOKEN="123456789:replace-with-bot-token"
# TELEGRAM_CHAT_ID="123456789"
# TELEGRAM_PROXY_URL="socks5h://username:password@proxy.example:1080"
